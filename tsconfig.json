{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@hunkyard/*": ["packages/*/src/index.ts"],
      "@hunkyard/core/ports": ["packages/core/src/ports.ts"],
      "@hunkyard/server/*": ["apps/server/src/*.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "*.config.ts"]
}
