{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@reviewlab/*": ["packages/*/src/index.ts"],
      "@reviewlab/core/ports": ["packages/core/src/ports.ts"],
      "@reviewlab/server/*": ["apps/server/src/*.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ]
}
