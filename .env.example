# Optional hosted credential: server/CLI environment only. Never commit a real key.
OPENAI_API_KEY=
# Target repository for pnpm dev / commands without --repo.
HUNKYARD_REPO=
# Optional absolute user config path outside the reviewed repository.
HUNKYARD_USER_CONFIG=
# Configure provider/model/privacy using: pnpm hunkyard config --repo PATH --help
# Default is Ollama on literal loopback, local-only, with no cloud fallback.
